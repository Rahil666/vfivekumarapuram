# Full Resend API key (CSV exports only show a masked prefix; create a new key in Resend if needed)
RESEND_API_KEY=
RESEND_API_KEY_SEC=

# Recipient email(s). With onboarding@resend.dev and no verified domain,
# this MUST be the Resend account owner email (e.g. rahilramesh666@gmail.com).
EMAIL_USER=rahilramesh666@gmail.com
EMAIL_USER_SEC=

# Google Apps Script Web App URL for Google Sheet lead logging
GOOGLE_SCRIPT_WEBHOOK_URL=
